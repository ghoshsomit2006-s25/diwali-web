rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('totalDiyasLit' in data) || (data.totalDiyasLit is number && data.totalDiyasLit >= 0));
    }

    function isValidGreetingCard(data) {
      return data.keys().hasAll(['id', 'userId', 'receiverName', 'message']) &&
             data.userId == request.auth.uid &&
             data.receiverName is string && data.receiverName.size() > 0 && data.receiverName.size() <= 60 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500;
    }

    function isValidSavedRangoli(data) {
      return data.keys().hasAll(['id', 'userId', 'dataUrl']) &&
             data.userId == request.auth.uid &&
             data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() <= 100000;
    }

    function isValidPublicWish(data) {
      return data.keys().hasAll(['id', 'name', 'wish']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
             data.wish is string && data.wish.size() > 0 && data.wish.size() <= 300 &&
             (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 60));
    }

    // User profile
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;

      // User greeting cards
      match /greetings/{greetingId} {
        allow read: if true;
        allow create: if isOwner(userId) && isValidId(greetingId) && isValidGreetingCard(request.resource.data);
        allow update: if isOwner(userId) && isValidId(greetingId) && isValidGreetingCard(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(greetingId);
      }

      // User saved rangolis
      match /rangolis/{rangoliId} {
        allow read: if true;
        allow create: if isOwner(userId) && isValidId(rangoliId) && isValidSavedRangoli(request.resource.data);
        allow update: if isOwner(userId) && isValidId(rangoliId) && isValidSavedRangoli(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(rangoliId);
      }
    }

    // Public Wish Wall
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if isValidId(wishId) && isValidPublicWish(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
